# TMDB API Credentials (v3 API key or v4 Bearer Token)
VITE_TMDB_API_KEY=
VITE_TMDB_ACCESS_TOKEN=

# Optional YouTube Data API Key (if external YouTube discovery is needed)
VITE_YOUTUBE_API_KEY=

# Server-Side RapidAPI Anime DB Provider Credentials (Secret - never expose to client)
RAPIDAPI_KEY=
RAPIDAPI_ANIME_HOST=anime-db.p.rapidapi.com
